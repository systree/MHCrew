PORT=3001
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GHL_API_BASE_URL=https://services.leadconnectorhq.com
# Your GHL Marketplace App ID (visible in GHL → App Marketplace → Your App)
GHL_APP_ID=
# n8n endpoint that returns { access_token } given location_id + app_id query params
N8N_TOKEN_ENDPOINT=https://n8n.app.systree.com.au/webhook/get-token
# Ed25519 public key from GHL app settings (Marketplace → Your App → Webhook → Signature)
# Flatten the PEM onto one line — replace actual newlines with \n, wrap in double quotes:
GHL_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAi2HR1srL4o18O8BRa7gVJY7G7bupbN3H9AwJrHCDiOg=\n-----END PUBLIC KEY-----"
JWT_SECRET=
MOBILEMESSAGE_API_KEY=
MOBILEMESSAGE_SENDER_ID=MoverHero
# Dev bypass: comma-separated phones that skip SMS and log OTP to console instead
# e.g. OTP_BYPASS_PHONES=+61412345678,+61498765432
OTP_BYPASS_PHONES=
# Web Push (VAPID) — generate keys once with:  npx web-push generate-vapid-keys
# Then copy the output below. VAPID_SUBJECT should be a mailto: or https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@moverhero.com.au
GHL_PIT_NAME=Master
# Comma-separated allowlist of categories or category.action pairs to show in the activity log.
# Use a whole category (e.g. "auth") to show all events in it, or "category.action" for a single event.
# If empty or unset, all entries are shown.
#
# All possible values:
#   auth                          — all auth events (alias for all auth.* below)
#   auth.otp_sent                 — OTP SMS sent to a crew member
#   auth.otp_send_error           — OTP SMS failed to send
#   auth.otp_verify_failed        — OTP verification attempt failed
#   auth.otp_verify_success       — OTP verified successfully
#   auth.pin_setup                — crew member set their PIN for the first time
#   auth.login_pin_failed         — wrong PIN entered
#   auth.login_success            — successful PIN login
#   auth.location_switched        — crew member switched company/location
#
#   job                           — all job events (alias for all job.* below)
#   job.status_update             — crew changed a job status (enroute, arrived, in_progress, etc.)
#   job.status_update_invalid     — crew attempted an invalid status transition
#   job.job_viewed                — crew opened a job detail page
#   job.photo_uploaded            — crew uploaded a job photo
#   job.photo_deleted             — crew deleted a job photo
#
#   invoice                       — all invoice events (alias for all invoice.* below)
#   invoice.invoice_created       — invoice created for a job
#   invoice.invoice_sent          — invoice sent to customer
#   invoice.invoice_deleted       — invoice deleted
#   invoice.invoice_from_estimate — invoice converted from an estimate
#   invoice.payment_recorded      — manual payment recorded on an invoice
#
#   admin                         — all admin events (alias for all admin.* below)
#   admin.pipeline_set            — admin selected a GHL pipeline
#   admin.stages_updated          — admin updated stage mappings
#   admin.crew_updated            — admin changed a crew member's role or status
#   admin.sync_jobs               — admin triggered a job sync from GHL
#   admin.sync_location           — admin triggered a location sync from GHL
#   admin.sync_stages             — admin triggered a stage sync from GHL
#   admin.sync_crew               — admin triggered a crew sync from GHL
#   admin.provision_fields        — admin provisioned custom fields in GHL
#   admin.invoice_settings_updated        — invoice settings changed
#   admin.notification_settings_updated  — push notification settings changed
#   admin.billing_rules_updated          — billing rules changed
#
#   system                        — all system events (alias for all system.* below)
#   system.app_install            — GHL app installed at a location
#   system.app_uninstall          — GHL app uninstalled at a location
#
#   webhook                       — all inbound GHL webhook events (alias for all webhook.* below)
#   webhook.received              — webhook event received from GHL
#   webhook.signature_failed      — webhook signature verification failed
#   webhook.tenant_rejected       — webhook rejected (location not set up)
#   webhook.processing_error      — error while processing a webhook event
#
ACTIVITY_LOG_SHOW=auth,job.status_update,job.status_update_invalid,invoice,admin,system.app_install,system.app_uninstall